# =========================================================
# MAIN DASHBOARD
# =========================================================
try:
    raw = load_data()
    volatility_bundle = load_volatility_model()
    direction_bundle = load_direction_model()

    required_columns = {
        "timestamp", "open", "high", "low", "close", "volume"
    }
    missing_columns = required_columns - set(raw.columns)

    if missing_columns:
        st.error(
            f"Missing data columns: {', '.join(sorted(missing_columns))}"
        )
        st.stop()

    # Build all features once.
    featured = build_features(raw)
    featured = featured.replace([np.inf, -np.inf], np.nan)

    # ---------------- VOLATILITY MODEL ----------------
    volatility_features = volatility_bundle["features"]
    volatility_model = volatility_bundle["model"]

    volatility_valid = featured.dropna(
        subset=volatility_features
    )

    if volatility_valid.empty:
        st.error(t["no_data"])
        st.stop()

    latest_volatility = volatility_valid.iloc[[-1]]
    latest = latest_volatility.iloc[0]

    current_price_usd = float(latest["close"])
    live_price_usd = get_live_btc_price()
    volatility_prediction = max(
        float(
            volatility_model.predict(
                latest_volatility[volatility_features]
            )[0]
        ),
        0.0,
    )
    volatility_pct = volatility_prediction * 100

    # ---------------- DIRECTION MODEL ----------------
    direction_features = direction_bundle["features"]
    direction_model = direction_bundle["model"]

    direction_valid = featured.dropna(
        subset=direction_features
    )

    if direction_valid.empty:
        st.error(t["no_data"])
        st.stop()

    latest_direction = direction_valid.iloc[[-1]]

    if not hasattr(direction_model, "predict_proba"):
        raise ValueError(
            "Direction model does not support predict_proba()."
        )

    probabilities = direction_model.predict_proba(
        latest_direction[direction_features]
    )[0]

    classes = list(direction_model.classes_)

    if 1 not in classes or 0 not in classes:
        raise ValueError(
            "Direction model must contain both classes 0 and 1."
        )

    up_probability = float(probabilities[classes.index(1)]) * 100
    down_probability = float(probabilities[classes.index(0)]) * 100

    if up_probability > down_probability:
        direction_label = t["direction_up"]
    elif down_probability > up_probability:
        direction_label = t["direction_down"]
    else:
        direction_label = t["direction_equal"]

    # ---------------- TIMESTAMPS ----------------
    data_time = pd.Timestamp(latest["timestamp"])

    if data_time.tzinfo is None:
        data_time = data_time.tz_localize("UTC")
    else:
        data_time = data_time.tz_convert("UTC")

    now_utc = pd.Timestamp.now(tz="UTC")
    age_hours = max(
        0.0,
        (now_utc - data_time).total_seconds() / 3600,
    )

    # The saved timestamp marks the candle close time.
    forecast_start = data_time
    forecast_end = data_time + pd.Timedelta(hours=4)

    # ---------------- EXCHANGE RATE ----------------
    try:
        
        fx_rate, fx_updated = get_usd_krw()
        fx_available = True
        current_price_krw = current_price_usd * fx_rate
        live_price_krw = live_price_usd * fx_rate
        # Taxminiy 4 soatlik narx diapazoni.
        # Bu statistik jihatdan kalibrlangan interval emas.
        # prediction — kelgusi 4 ta soatlik log-returnning prognoz qilingan std qiymati.
        approx_4h_sigma = volatility_prediction * np.sqrt(4)
        lower_price_krw = current_price_krw * np.exp(
            -1.96 * approx_4h_sigma
        )
        upper_price_krw = current_price_krw * np.exp(
            1.96 * approx_4h_sigma
        )

    except Exception:
        fx_available = False
        fx_rate = None
        fx_updated = None
        current_price_krw = None

    # =================================================
    # TOP METRICS
    # =================================================
    c1, c2, c3, c4 = st.columns(4)
    if fx_available:
        c1.metric(
            t["price"],
            f"₩{current_price_krw:,.0f}",
        )
        c4.metric(
        "Jonli BTC narxi" if lang == "uz" else "실시간 BTC 가격",
        f"₩{live_price_krw:,.0f}",
    )
    else:
        c1.metric(t["price"], "—")
        st.warning(t["fx_error"])

    c2.metric(
        t["volatility"],
        f"{volatility_pct:.4f}%",
    )

    c3.metric(
        t["horizon"],
        "4시간" if lang == "ko" else "4 soat",
    )

    # =================================================
    # FORECAST TIME
    # =================================================
    time_col1, time_col2 = st.columns(2)

    with time_col1:
        st.subheader(t["forecast_start"])
        st.write(format_kst(forecast_start))

    with time_col2:
        st.subheader(t["forecast_end"])
        st.write(format_kst(forecast_end))

    st.caption(
        f"{t['last_data']}: {format_kst(data_time)}"
    )

    age_text = (
        f"{t['data_age']}: {age_hours:.1f} {t['hours']}"
    )
    st.caption(age_text)

    if age_hours > 2:
        st.warning(t["stale"])

    # =================================================
    # DIRECTION FORECAST
    # =================================================
    st.divider()
    st.subheader(t["direction_title"])

    d1, d2 = st.columns(2)

    d1.metric(
        t["up"],
        f"{up_probability:.1f}%",
    )

    d2.metric(
        t["down"],
        f"{down_probability:.1f}%",
    )

    st.write(f"**{direction_label}**")
    st.caption(t["probability_note"])
    st.warning(t["warning"])


    # =================================================
    # APPROXIMATE 4-HOUR PRICE RANGE
