            yaxis_title=t["chart_price"],
            hovermode="x unified",
            margin=dict(l=10, r=10, t=30, b=10),
        )

        st.plotly_chart(fig, use_container_width=True)
        st.caption(t["fx_historical_note"])
    else:
        st.info(t["fx_error"])

    # =================================================
    # RECENT DATA
    # =================================================
    left, right = st.columns(2)

    with left:
        st.subheader(t["recent"])

        recent = raw.tail(10).sort_values(
            "timestamp", ascending=False
        ).copy()

        recent["timestamp"] = pd.to_datetime(
            recent["timestamp"], utc=True
        ).dt.tz_convert(KST).astype(str)

        if fx_available:
            recent["close_KRW"] = (
                recent["close"] * fx_rate
            ).round(0)

        st.dataframe(
            recent,
            use_container_width=True,
            hide_index=True,
        )

    # =================================================
    # MODEL DETAILS
    # =================================================
    with right:
        st.subheader(t["model_info"])

        st.write(
            f"**{t['volatility_model']}:** "
            f"{volatility_bundle.get('model_name', 'Ridge Regression')}"
        )

        st.write(
            f"**{t['direction_model']}:** "
            f"{direction_bundle.get('model_name', type(direction_model).__name__)}"
        )

        st.write(t["forecast_description"])
        st.write(f"**{t['records']}:** {len(raw):,}")

        st.write(
            f"**{t['trained_until']}:** "
            f"{direction_bundle.get('trained_until', 'Unknown')}"
        )

    st.caption(t["source"])

except Exception as exc:
    st.error(f"Dashboard error: {exc}")
    st.exception(exc)
