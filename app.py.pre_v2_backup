    if fx_available:
        st.subheader(
            "💰 Keyingi 4 soat uchun taxminiy narx oralig‘i"
            if lang == "uz"
            else "💰 향후 4시간 예상 가격 범위"
        )

        r1, r2, r3 = st.columns(3)

        r1.metric(
            "Joriy narx" if lang == "uz" else "현재 가격",
            f"₩{current_price_krw:,.0f}",
        )

        r2.metric(
            "Taxminiy pastki chegara" if lang == "uz" else "예상 하한",
            f"₩{lower_price_krw:,.0f}",
        )

        r3.metric(
            "Taxminiy yuqori chegara" if lang == "uz" else "예상 상한",
            f"₩{upper_price_krw:,.0f}",
        )

        st.info(
            f"Taxminiy diapazon: ₩{lower_price_krw:,.0f} – "
            f"₩{upper_price_krw:,.0f}. "
            "Bu soddalashtirilgan matematik taxmin; model tomonidan "
