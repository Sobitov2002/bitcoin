# =========================================================
# LOAD DATA AND MODELS
# =========================================================
@st.cache_data(ttl=60)
def load_data():
    df = pd.read_csv(DATA_PATH, parse_dates=["timestamp"])
    df["timestamp"] = pd.to_datetime(df["timestamp"], utc=True)

    return (
        df.sort_values("timestamp")
        .drop_duplicates("timestamp", keep="last")
        .reset_index(drop=True)
    )


@st.cache_resource
def load_volatility_model():
    return joblib.load(VOLATILITY_MODEL_PATH)


@st.cache_resource
def load_direction_model():
    return joblib.load(DIRECTION_MODEL_PATH)



@st.cache_data(ttl=10)
def get_live_btc_price():
    url = "https://data-api.binance.vision/api/v3/ticker/price"

    response = requests.get(
        url,
        params={"symbol": "BTCUSDT"},
        timeout=10,
    )
    response.raise_for_status()

    data = response.json()
    return float(data["price"])
@st.cache_data(ttl=900)
def get_usd_krw():
    response = requests.get(FX_URL, timeout=10)
    response.raise_for_status()
    result = response.json()

    if result.get("result") != "success":
        raise ValueError("Exchange rate service returned an unsuccessful response.")

    rate = float(result["rates"]["KRW"])
    updated = result.get("time_last_update_utc", "Unknown")

    if rate <= 0:
        raise ValueError("Invalid USD/KRW rate.")

    return rate, updated


# =========================================================
# UPDATE BINANCE DATA
# =========================================================
def refresh_market_data():
    """Fetch recent completed hourly candles and merge them into the CSV."""
    response = requests.get(
        BINANCE_URL,
        params={
            "symbol": "BTCUSDT",
            "interval": "1h",
            "limit": 1000,
        },
        timeout=20,
    )
    response.raise_for_status()
    candles = response.json()

    if not isinstance(candles, list) or not candles:
        raise ValueError("Binance returned no candle data.")

    now = pd.Timestamp.now(tz="UTC")
    rows = []

    for candle in candles:
        open_time = pd.to_datetime(candle[0], unit="ms", utc=True)
        close_time = open_time + pd.Timedelta(hours=1)

        # Skip the currently open candle.
        if close_time > now:
            continue

        rows.append({
            "timestamp": close_time,
            "open": float(candle[1]),
            "high": float(candle[2]),
            "low": float(candle[3]),
            "close": float(candle[4]),
            "volume": float(candle[5]),
        })

    if not rows:
        raise ValueError("No completed hourly candles returned.")

    fresh = pd.DataFrame(rows)

    if DATA_PATH.exists():
        old = load_data().copy()
        combined = pd.concat([old, fresh], ignore_index=True, sort=False)
    else:
        combined = fresh

    combined["timestamp"] = pd.to_datetime(
        combined["timestamp"], utc=True
    )
    combined = (
        combined.sort_values("timestamp")
        .drop_duplicates("timestamp", keep="last")
        .reset_index(drop=True)
    )

    DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
    combined.to_csv(DATA_PATH, index=False)

    load_data.clear()
    get_usd_krw.clear()
    get_live_btc_price.clear()

    return len(fresh)


# =========================================================
# FEATURE ENGINEERING
# Must match the features used during model training.
# =========================================================
def build_features(df):
    df = df.copy()

    close = df["close"]
    volume = df["volume"]

    df["log_return"] = np.log(close / close.shift(1))
    df["vol_4h"] = df["log_return"].rolling(4).std()
    df["vol_24h"] = df["log_return"].rolling(24).std()
    df["vol_72h"] = df["log_return"].rolling(72).std()

    df["return_1h"] = df["log_return"]
    df["return_4h"] = np.log(close / close.shift(4))
    df["return_24h"] = np.log(close / close.shift(24))

    df["volume_change_24h"] = volume.pct_change(24)
    df["range_pct"] = (df["high"] - df["low"]) / close

    return df


def format_kst(timestamp):
    timestamp = pd.Timestamp(timestamp)

    if timestamp.tzinfo is None:
        timestamp = timestamp.tz_localize("UTC")

    return timestamp.tz_convert(KST).strftime("%Y-%m-%d %H:%M KST")


